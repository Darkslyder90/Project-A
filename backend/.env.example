# Kopieren nach backend/.env und anpassen. Fuer lokale Entwicklung reichen die
# Defaults i. d. R. aus (siehe app/config.py) - .env ist nur fuer Abweichungen/Secrets noetig.

# "dev" oder "prod" - beeinflusst nur den DATA_DIR-Default.
ENV=dev

# Basisverzeichnis fuer SQLite-DB, Uploads, Chroma, Embedding-Model-Cache, Backups.
# Dev-Default (siehe config.py): <repo-root>/data-dev
# Prod (Docker): auf ein Volume ausserhalb des Containers zeigen, z. B. /data
# DATA_DIR=/data

# Fernet-Key zur Verschluesselung des in SQLite gespeicherten Claude-API-Keys.
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG (siehe README "Encryption-Secret"): getrennt von normalen Backups aufbewahren -
# geht dieser Key verloren, ist ein bereits gespeicherter Claude-Key nicht mehr entschluesselbar.
SETTINGS_ENCRYPTION_KEY=

# Optionaler Fallback-Claude-API-Key, falls in der DB (Settings-UI) keiner hinterlegt ist.
# Bis Schritt 13 (Settings-UI mit DB-gespeichertem, verschluesseltem Key) ist
# dies aktuell die EINZIGE Quelle fuer den Chat - ohne diesen Key antwortet
# der Chat-Endpunkt mit HTTP 503, der Rest der App bleibt aber nutzbar.
CLAUDE_API_KEY=

# Default-Claude-Modell fuer den Chat (unabhaengig vom lokalen Embedding-Modell).
# Bis zur Settings-UI (Schritt 13) nur per .env aenderbar.
CLAUDE_MODEL_DEFAULT=claude-opus-5

# Maximale Upload-Groesse in MB.
MAX_UPLOAD_SIZE_MB=50

# Kommagetrennte Liste erlaubter Frontend-Origins (CORS). In Prod i. d. R. nicht
# noetig, da Frontend+Backend hinter demselben Reverse Proxy laufen.
CORS_ORIGINS=http://localhost:5173
