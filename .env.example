# Kopieren nach .env (Repo-Root) fuer das Produktiv-Deployment per
# docker compose (siehe docker-compose.yml, scripts/update.sh). Betrifft NUR
# den Docker-Betrieb - fuer lokale Entwicklung siehe stattdessen
# backend/.env.example (kein Docker, siehe README).

# Domain, unter der die App erreichbar ist (fuer Caddy + automatisches HTTPS).
DOMAIN=project-a.beispiel.de

# Basic-Auth-Zugangsdaten fuer den gesamten Bereich (siehe Briefing:
# "Server ist oeffentlich erreichbar -> Basic-Auth vor die App legen").
# Passwort-Hash erzeugen mit:
#   docker run --rm caddy caddy hash-password --plaintext 'dein-passwort'
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=

# Fernet-Key zur Verschluesselung des in SQLite gespeicherten Claude-API-Keys.
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG (siehe README "Encryption-Secret"): getrennt von den normalen
# Update-Backups aufbewahren (z. B. Passwortmanager) - geht dieser Key
# verloren, ist ein bereits gespeicherter Claude-Key nicht mehr
# entschluesselbar und muss in den Einstellungen neu eingegeben werden.
SETTINGS_ENCRYPTION_KEY=

# Optionaler Fallback-Claude-API-Key, falls in der DB (Einstellungen-UI)
# keiner hinterlegt ist.
CLAUDE_API_KEY=

# Default-Claude-Modell fuer den Chat (unabhaengig vom lokalen Embedding-Modell,
# in den Einstellungen ueberschreibbar).
CLAUDE_MODEL_DEFAULT=claude-opus-5

# Maximale Upload-Groesse in MB.
MAX_UPLOAD_SIZE_MB=50

# Optionaler expliziter DATABASE_URL-Override - normalerweise nicht noetig,
# der Default (SQLite unter /data) reicht.
DATABASE_URL=

# CORS: in Prod i. d. R. leer lassen, da Frontend+Backend hinter demselben
# Reverse Proxy (Caddy) auf derselben Origin laufen.
CORS_ORIGINS=
